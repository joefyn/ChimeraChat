{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code Plan Schema", 
  "description": "Schema for code.plan.json - atomic development operations",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Plan creation timestamp"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique operation identifier"
          },
          "type": {
            "type": "string",
            "enum": ["create_file", "modify_file", "delete_file", "move_file", "create_test", "update_docs"],
            "description": "Type of operation"
          },
          "target": {
            "type": "string",
            "description": "Target file path"
          },
          "anchor": {
            "type": "string",
            "description": "Anchor point for targeting"
          },
          "expect_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Expected SHA256 hash of target file"
          },
          "changes": {
            "type": "string",
            "description": "Description of changes to make"
          },
          "rationale": {
            "type": "string",
            "description": "Why this change is needed"
          },
          "preconditions": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Prerequisites for this operation"
          },
          "postconditions": {
            "type": "array", 
            "items": {"type": "string"},
            "description": "Expected state after operation"
          }
        },
        "required": ["id", "type", "target", "expect_sha", "changes", "rationale"],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {"type": "string", "enum": ["requires", "blocks", "enhances"]}
        },
        "required": ["from", "to", "type"]
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object", 
        "properties": {
          "type": {"type": "string"},
          "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
          "description": {"type": "string"},
          "mitigation": {"type": "string"}
        },
        "required": ["type", "severity", "description"]
      }
    },
    "complexity_metrics": {
      "type": "object",
      "properties": {
        "total_operations": {"type": "integer"},
        "files_affected": {"type": "integer"},
        "estimated_hours": {"type": "number"},
        "risk_score": {"type": "number", "minimum": 0, "maximum": 10}
      }
    }
  },
  "required": ["version", "timestamp", "operations"],
  "additionalProperties": false
}